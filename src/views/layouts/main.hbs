<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Tech Docs</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dark-theme">
    <div class="app-wrapper">
        <!-- Боковое меню -->
        <aside class="sidebar">
            <div class="logo">
                <img src="https://nestjs.com" width="40" alt="Logo">
                <span>TECH DOCS</span>
            </div>
            <nav class="menu">
                <div class="menu-item">INTRODUCTION</div>
                <div class="menu-item has-submenu active">
                    TOPICS
                    <ul class="submenu">
                        {{#each topics}}
                            <li><a href="/topics/{{this._id}}" class="{{#if active}}active{{/if}}">{{this.title}}</a></li>
                        {{/each}}
                    </ul>
                </div>
                <div class="menu-item">CATEGORIES</div>
            </nav>
        </aside>

        <!-- Основной контент -->
        <main class="content">
            <header class="top-nav">
                <div class="search-bar">🔍 Search...</div>
            </header>
            <div class="article-body">
                {{{body}}}
            </div>
        </main>
    </div>
</body>
</html>
