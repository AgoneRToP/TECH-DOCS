<div class="topics-page">
  <h1>Статьи (Topics)</h1>
  <a href="/topics/create" class="btn-create">Создать новую</a>

  <div class="topics-list">
    {{#each topics}}
      <article class="topic-item">
        <div class="topic-meta">
          <span class="category">{{this.category.name}}</span>
          <span class="status {{this.status}}">{{this.status}}</span>
        </div>
        
        <h2 class="topic-title">
          <a href="/topics/{{this._id}}">{{this.title}}</a>
        </h2>
        
        <p class="topic-slug">slug: <code>{{this.slug}}</code></p>
        
        <div class="topic-footer">
          <span>Автор: {{#if this.author}}{{this.author}}{{else}}Аноним{{/if}}</span>
          <div class="actions">
            <a href="/topics/edit/{{this._id}}">✏️</a>
            <button onclick="deleteTopic('{{this._id}}')">🗑️</button>
          </div>
        </div>
      </article>
    {{/each}}
  </div>
</div>
