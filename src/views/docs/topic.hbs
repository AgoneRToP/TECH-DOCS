<article class="topic-detail">
    <header>
        <h1>{{title}}</h1>
        <div class="topic-meta">
            <span class="category">{{category.name}}</span>
            <time>{{createdAt}}</time>
        </div>
    </header>
    <div class="topic-content">
        {{{content}}}
    </div>
</article>
